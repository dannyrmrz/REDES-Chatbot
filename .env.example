# Copy this file to `.env` and fill it in. `.env` is ignored by git.
# Get a key at https://console.anthropic.com/ -> Settings -> API keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-opus-5. Use claude-haiku-4-5 to spend less.
# ANTHROPIC_MODEL=claude-opus-5

# Address of the clinic server once deployed. Fill this in and set
# "clinic-remote" to enabled in config/servers.json to use it.
CLINIC_REMOTE_URL=https://your-service.onrender.com/mcp
